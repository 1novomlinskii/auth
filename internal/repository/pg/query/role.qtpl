{% package query %}

{% comment %}
InsertRole — создать роль
$1 - roleID       — UUID роли
$2 - tenantID     — UUID тенанта
$3 - name         — название роли
$4 - permissions  — права доступа (строка через запятую, формируется в caller)
$5 - isSystem     — системная роль (bool, драйвер → TRUE/FALSE)
$6 - description  — описание роли
{% endcomment %}
{% func InsertRole() %}
INSERT INTO roles (
    role_id,
    tenant_id,
    name,
    permissions,
    is_system,
    description,
    created_at,
    updated_at
)
VALUES (
    $1,
    $2,
    $3,
    $4,
    $5,
    $6,
    NOW(),
    NULL
)
RETURNING created_at
{% endfunc %}

{% comment %}
SelectRoleByID
$1 - roleID — UUID роли
{% endcomment %}
{% func SelectRoleByID() %}
SELECT role_id,
       tenant_id,
       name,
       permissions,
       is_system,
       COALESCE(description, '') AS description,
       created_at,
       updated_at
FROM roles
WHERE role_id = $1
{% endfunc %}

{% comment %}
SelectRoleByName
$1 - tenantID — UUID тенанта
$2 - name     — название роли
{% endcomment %}
{% func SelectRoleByName() %}
SELECT role_id,
       tenant_id,
       name,
       permissions,
       is_system,
       COALESCE(description, '') AS description,
       created_at,
       updated_at
FROM roles
WHERE tenant_id = $1
  AND name      = $2
{% endfunc %}

{% comment %}
SelectRoles — список ролей с пагинацией
$1 - limit   — размер страницы (LIMIT)
$2 - offset  — смещение (OFFSET)
{% endcomment %}
{% func SelectRoles() %}
SELECT role_id,
       tenant_id,
       name,
       permissions,
       is_system,
       COALESCE(description, '') AS description,
       created_at,
       updated_at
FROM roles
ORDER BY created_at DESC
LIMIT $1
OFFSET $2
{% endfunc %}

{% comment %}
CountRoles — общее количество ролей
Параметров нет
{% endcomment %}
{% func CountRoles() %}
SELECT COUNT(*) AS total
FROM roles
{% endfunc %}

{% comment %}
UpdateRole — обновить роль
$1 - name        — новое название
$2 - permissions — новые права (строка через запятую)
$3 - description — новое описание
$4 - roleID      — UUID роли
{% endcomment %}
{% func UpdateRole() %}
UPDATE roles
SET name        = $1,
    permissions = $2,
    description = $3,
    updated_at  = NOW()
WHERE role_id = $4
{% endfunc %}

{% comment %}
DeleteRole — удаление роли (только не системные)
$1 - roleID — UUID роли
{% endcomment %}
{% func DeleteRole() %}
DELETE FROM roles
WHERE role_id   = $1
  AND is_system = FALSE
{% endfunc %}

{% comment %}
AssignRoleToUser — назначить роль пользователю
$1 - userID — UUID пользователя
$2 - roleID — UUID роли
{% endcomment %}
{% func AssignRoleToUser() %}
INSERT INTO user_roles (user_id, role_id, assigned_at)
VALUES ($1, $2, NOW())
ON CONFLICT (user_id, role_id) DO NOTHING
{% endfunc %}

{% comment %}
RevokeRoleFromUser — отозвать роль у пользователя
$1 - userID — UUID пользователя
$2 - roleID — UUID роли
{% endcomment %}
{% func RevokeRoleFromUser() %}
DELETE FROM user_roles
WHERE user_id = $1
  AND role_id = $2
{% endfunc %}

{% comment %}
SelectUserRoles — список ролей пользователя
$1 - userID — UUID пользователя
{% endcomment %}
{% func SelectUserRoles() %}
SELECT r.role_id,
       r.tenant_id,
       r.name,
       r.permissions,
       r.is_system,
       COALESCE(r.description, '') AS description,
       r.created_at,
       r.updated_at
FROM roles r
JOIN user_roles ur ON r.role_id = ur.role_id
WHERE ur.user_id = $1
{% endfunc %}

{% comment %}
CheckUserPermission — проверка разрешения у пользователя
$1 - userID     — UUID пользователя
$2 - permission — название разрешения
{% endcomment %}
{% func CheckUserPermission() %}
SELECT EXISTS (
    SELECT 1
    FROM user_roles ur
    JOIN roles r ON r.role_id = ur.role_id
    CROSS JOIN LATERAL unnest(r.permissions) AS p(perm)
    WHERE ur.user_id = $1
      AND p.perm     = $2
) AS has_permission
{% endfunc %}