{% package query %}

{% func InsertPassword(userID, passwordHash string) %}
INSERT INTO user_password_hash (
    user_id,
    password_hash,
    created_at,
    updated_at
)
VALUES (
    {%s userID %},
    {%s passwordHash %},
    NOW(),
    NULL
)
{% endfunc %}

{% func SelectPasswordByUserID(userID string) %}
SELECT password_hash
FROM user_password_hash
WHERE user_id = {%s userID %}
{% endfunc %}

{% func UpdatePassword(userID, passwordHash string) %}
UPDATE user_password_hash
SET password_hash = {%s passwordHash %},
    updated_at    = NOW()
WHERE user_id = {%s userID %}
{% endfunc %}