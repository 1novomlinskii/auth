{% package query %}

{% comment %}
InsertPassword
$1 - userID         — UUID пользователя
$2 - passwordHash   — Argon2 хеш пароля
{% endcomment %}
{% func InsertPassword() %}
INSERT INTO user_password_hash (
    user_id,
    password_hash,
    created_at,
    updated_at
)
VALUES (
    $1,
    $2,
    NOW(),
    NULL
)
{% endfunc %}

{% comment %}
SelectPasswordByUserID
$1 - userID — UUID пользователя
{% endcomment %}
{% func SelectPasswordByUserID() %}
SELECT password_hash
FROM user_password_hash
WHERE user_id = $1
{% endfunc %}

{% comment %}
UpdatePassword
$1 - passwordHash  — новый Argon2 хеш
$2 - userID        — UUID пользователя
{% endcomment %}
{% func UpdatePassword() %}
UPDATE user_password_hash
SET password_hash = $1,
    updated_at    = NOW()
WHERE user_id = $2
{% endfunc %}