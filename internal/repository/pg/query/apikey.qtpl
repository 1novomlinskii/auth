{% package query %}

{% comment %}
InsertAPIKey — создать API ключ
$1 - apiKeyID     — UUID ключа
$2 - tenantID     — UUID тенанта
$3 - serviceName  — название сервиса
$4 - keyPrefix    — префикс ключа
$5 - keyHash      — хеш ключа
$6 - permissions  — права доступа (строка, через запятую, формируется в caller)
$7 - createdBy    — кем создан
$8 - expiresAt    — срок истечения (TIMESTAMPTZ, NULL = бессрочно)
{% endcomment %}
{% func InsertAPIKey() %}
INSERT INTO api_keys (
    api_key_id,
    tenant_id,
    service_name,
    key_prefix,
    key_hash,
    permissions,
    created_by,
    expires_at,
    is_active,
    created_at
)
VALUES (
    $1,
    $2,
    $3,
    $4,
    $5,
    $6,
    $7,
    $8::TIMESTAMPTZ,
    TRUE,
    NOW()
)
RETURNING created_at
{% endfunc %}

{% comment %}
SelectAPIKeyByID
$1 - apiKeyID — UUID ключа
{% endcomment %}
{% func SelectAPIKeyByID() %}
SELECT api_key_id,
       tenant_id,
       service_name,
       key_prefix,
       key_hash,
       permissions,
       created_by,
       expires_at,
       is_active,
       created_at
FROM api_keys
WHERE api_key_id = $1
{% endfunc %}

{% comment %}
SelectAPIKeyByHash
$1 - keyHash — хеш ключа
{% endcomment %}
{% func SelectAPIKeyByHash() %}
SELECT api_key_id,
       tenant_id,
       service_name,
       key_prefix,
       key_hash,
       permissions,
       created_by,
       expires_at,
       is_active,
       created_at
FROM api_keys
WHERE key_hash  = $1
  AND is_active = TRUE
{% endfunc %}

{% comment %}
SelectAPIKeys — список API ключей с пагинацией
$1 - limit   — размер страницы (LIMIT)
$2 - offset  — смещение (OFFSET)
{% endcomment %}
{% func SelectAPIKeys() %}
SELECT api_key_id,
       tenant_id,
       service_name,
       key_prefix,
       key_hash,
       permissions,
       created_by,
       expires_at,
       is_active,
       created_at
FROM api_keys
ORDER BY created_at DESC
LIMIT $1
OFFSET $2
{% endfunc %}

{% comment %}
CountAPIKeys — общее количество API ключей
Параметров нет
{% endcomment %}
{% func CountAPIKeys() %}
SELECT COUNT(*) AS total
FROM api_keys
{% endfunc %}

{% comment %}
RevokeAPIKey — отзыв API ключа (is_active = FALSE)
$1 - apiKeyID — UUID ключа
{% endcomment %}
{% func RevokeAPIKey() %}
UPDATE api_keys
SET is_active = FALSE
WHERE api_key_id = $1
{% endfunc %}