{% package query %}

{% func InsertUser(userID, tenantID, login, displayName, emailPrimary, locale, timezone string) %}
INSERT INTO users (
    user_id,
    tenant_id,
    login,
    display_name,
    email_primary,
    locale,
    timezone,
    created_at,
    updated_at,
    is_active
)
VALUES (
    {%s userID %},
    {%s tenantID %},
    {%s login %},
    {%s displayName %},
    {%s emailPrimary %},
    {%s locale %},
    {%s timezone %},
    NOW(),
    NULL,
    TRUE
)
RETURNING created_at
{% endfunc %}

{% func SelectUserByID(userID string) %}
SELECT user_id,
       tenant_id,
       login,
       COALESCE(display_name, '') AS display_name,
       email_primary,
       COALESCE(locale, '')       AS locale,
       COALESCE(timezone, '')     AS timezone,
       is_active,
       created_at,
       updated_at
FROM users
WHERE user_id = {%s userID %}
{% endfunc %}

{% func SelectUserByLogin(login string) %}
SELECT user_id,
       tenant_id,
       login,
       COALESCE(display_name, '') AS display_name,
       email_primary,
       COALESCE(locale, '')       AS locale,
       COALESCE(timezone, '')     AS timezone,
       is_active,
       created_at,
       updated_at
FROM users
WHERE login = {%s login %}
{% endfunc %}

{% func SelectUserByEmail(email string) %}
SELECT user_id,
       tenant_id,
       login,
       COALESCE(display_name, '') AS display_name,
       email_primary,
       COALESCE(locale, '')       AS locale,
       COALESCE(timezone, '')     AS timezone,
       is_active,
       created_at,
       updated_at
FROM users
WHERE email_primary = {%s email %}
{% endfunc %}

{% func UpdateUser(userID, displayName, locale, timezone string) %}
UPDATE users
SET display_name = {%s displayName %},
    locale       = {%s locale %},
    timezone     = {%s timezone %},
    updated_at   = NOW()
WHERE user_id = {%s userID %}
{% endfunc %}

{% func SelectUsers(page, pageSize int) %}
SELECT user_id,
       tenant_id,
       login,
       COALESCE(display_name, '') AS display_name,
       email_primary,
       COALESCE(locale, '')       AS locale,
       COALESCE(timezone, '')     AS timezone,
       is_active,
       created_at,
       updated_at
FROM users
ORDER BY created_at DESC
LIMIT {%d pageSize %}
OFFSET {%d (page - 1) * pageSize %}
{% endfunc %}

{% func CountUsers() %}
SELECT COUNT(*) AS total
FROM users
{% endfunc %}