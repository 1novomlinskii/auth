{% package query %}

{% comment %}
InsertUser — создать пользователя
$1 - userID        — UUID пользователя
$2 - tenantID      — UUID тенанта
$3 - login         — логин пользователя
$4 - displayName   — отображаемое имя
$5 - emailPrimary  — основной email
$6 - locale        — локаль (например, ru_RU)
$7 - timezone      — часовой пояс
{% endcomment %}
{% func InsertUser() %}
INSERT INTO users (
    user_id,
    tenant_id,
    login,
    display_name,
    email_primary,
    locale,
    timezone,
    created_at,
    updated_at,
    is_active
)
VALUES (
    $1,
    $2,
    $3,
    $4,
    $5,
    $6,
    $7,
    NOW(),
    NULL,
    TRUE
)
RETURNING created_at
{% endfunc %}

{% comment %}
SelectUserByID — найти пользователя по ID
$1 - userID — UUID пользователя
{% endcomment %}
{% func SelectUserByID() %}
SELECT user_id,
       tenant_id,
       login,
       COALESCE(display_name, '') AS display_name,
       email_primary,
       COALESCE(locale, '')       AS locale,
       COALESCE(timezone, '')     AS timezone,
       is_active,
       created_at,
       updated_at
FROM users
WHERE user_id = $1
{% endfunc %}

{% comment %}
SelectUserByLogin — найти пользователя по логину
$1 - login — логин пользователя
{% endcomment %}
{% func SelectUserByLogin() %}
SELECT user_id,
       tenant_id,
       login,
       COALESCE(display_name, '') AS display_name,
       email_primary,
       COALESCE(locale, '')       AS locale,
       COALESCE(timezone, '')     AS timezone,
       is_active,
       created_at,
       updated_at
FROM users
WHERE login = $1
{% endfunc %}

{% comment %}
SelectUserByEmail — найти пользователя по email
$1 - email — email пользователя
{% endcomment %}
{% func SelectUserByEmail() %}
SELECT user_id,
       tenant_id,
       login,
       COALESCE(display_name, '') AS display_name,
       email_primary,
       COALESCE(locale, '')       AS locale,
       COALESCE(timezone, '')     AS timezone,
       is_active,
       created_at,
       updated_at
FROM users
WHERE email_primary = $1
{% endfunc %}

{% comment %}
UpdateUser — обновить данные пользователя
$1 - displayName  — новое отображаемое имя
$2 - locale       — новая локаль
$3 - timezone     — новый часовой пояс
$4 - userID       — UUID пользователя
{% endcomment %}
{% func UpdateUser() %}
UPDATE users
SET display_name = $1,
    locale       = $2,
    timezone     = $3,
    updated_at   = NOW()
WHERE user_id = $4
{% endfunc %}

{% comment %}
SelectUsers — список пользователей с пагинацией
$1 - limit   — размер страницы (LIMIT)
$2 - offset  — смещение (OFFSET)
{% endcomment %}
{% func SelectUsers() %}
SELECT user_id,
       tenant_id,
       login,
       COALESCE(display_name, '') AS display_name,
       email_primary,
       COALESCE(locale, '')       AS locale,
       COALESCE(timezone, '')     AS timezone,
       is_active,
       created_at,
       updated_at
FROM users
ORDER BY created_at DESC
LIMIT $1
OFFSET $2
{% endfunc %}

{% comment %}
CountUsers — общее количество пользователей
Параметров нет
{% endcomment %}
{% func CountUsers() %}
SELECT COUNT(*) AS total
FROM users
{% endfunc %}