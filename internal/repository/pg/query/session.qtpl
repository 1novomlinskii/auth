{% package query %}

{% comment %}
InsertSession — создать сессию
$1 - sessionID         — UUID сессии
$2 - userID            — UUID пользователя
$3 - identityID        — UUID identity (NULL = нет identity)
$4 - refreshTokenHash  — хеш refresh токена
$5 - deviceInfo        — информация об устройстве (NULL = нет)
$6 - ipAddress         — IP адрес с ::INET (NULL = нет)
$7 - expiresAt         — срок истечения (TIMESTAMPTZ, NULL = бессрочно)
NULL передаётся через драйвер БД, касты сохраняются
{% endcomment %}
{% func InsertSession() %}
INSERT INTO user_sessions (
    session_id,
    user_id,
    identity_id,
    refresh_token,
    device_info,
    ip_address,
    expires_at,
    created_at,
    revoked_at
)
VALUES (
    $1,
    $2,
    $3,
    $4,
    $5,
    $6::INET,
    $7::TIMESTAMPTZ,
    NOW(),
    NULL
)
RETURNING created_at
{% endfunc %}

{% comment %}
SelectSessionByRefreshToken
$1 - refreshTokenHash — хеш refresh токена
{% endcomment %}
{% func SelectSessionByRefreshToken() %}
SELECT session_id,
       user_id,
       identity_id,
       refresh_token,
       COALESCE(device_info, '') AS device_info,
       ip_address,
       expires_at,
       created_at,
       revoked_at
FROM user_sessions
WHERE refresh_token = $1
  AND revoked_at    IS NULL
{% endfunc %}

{% comment %}
RevokeSession — отзыв сессии
$1 - sessionID — UUID сессии
{% endcomment %}
{% func RevokeSession() %}
UPDATE user_sessions
SET revoked_at = NOW()
WHERE session_id = $1
{% endfunc %}

{% comment %}
RevokeAllUserSessions — отзыв всех сессий пользователя
$1 - userID — UUID пользователя
{% endcomment %}
{% func RevokeAllUserSessions() %}
UPDATE user_sessions
SET revoked_at = NOW()
WHERE user_id    = $1
  AND revoked_at IS NULL
{% endfunc %}