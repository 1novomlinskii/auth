{% package query %}

{% func InsertSession(sessionID, userID string, identityID *string, refreshTokenHash string, deviceInfo, ipAddress *string, expiresAt string) %}
INSERT INTO user_sessions (
    session_id,
    user_id,
    identity_id,
    refresh_token,
    device_info,
    ip_address,
    expires_at,
    created_at,
    revoked_at
)
VALUES (
    {%s sessionID %},
    {%s userID %},
    {% if identityID != nil %}{%s *identityID %}{% else %}NULL{% endif %},
    {%s refreshTokenHash %},
    {% if deviceInfo != nil %}{%s *deviceInfo %}{% else %}NULL{% endif %},
    {% if ipAddress != nil %}{%s *ipAddress %}::INET{% else %}NULL{% endif %},
    {%s expiresAt %}::TIMESTAMPTZ,
    NOW(),
    NULL
)
RETURNING created_at
{% endfunc %}

{% func SelectSessionByRefreshToken(refreshTokenHash string) %}
SELECT session_id,
       user_id,
       identity_id,
       refresh_token,
       COALESCE(device_info, '') AS device_info,
       ip_address,
       expires_at,
       created_at,
       revoked_at
FROM user_sessions
WHERE refresh_token = {%s refreshTokenHash %}
  AND revoked_at    IS NULL
{% endfunc %}

{% func RevokeSession(sessionID string) %}
UPDATE user_sessions
SET revoked_at = NOW()
WHERE session_id = {%s sessionID %}
{% endfunc %}

{% func RevokeAllUserSessions(userID string) %}
UPDATE user_sessions
SET revoked_at = NOW()
WHERE user_id    = {%s userID %}
  AND revoked_at IS NULL
{% endfunc %}