{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "bash": {
    "go*": "allow",
    "rg*": "allow",
    "mkdir*": "allow",
    "sudo*": "deny",
    "rm": "ask",
    "rm *": "deny",
    "mkfs*": "deny",
    "dd*": "deny",
    "chmod 0*": "deny",
    "chmod -R 0": "deny",
    ":(){": "deny",
    "*": "ask"
  },
    "skill": {
      "golang-*": "allow",
      "frontend-*": "allow",
      "dba-*": "allow",
      "prompt-engineer-*": "allow",
      "architect*": "allow",
      "*": "deny"
    }
  },
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash"
}